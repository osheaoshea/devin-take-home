# Environments differ ONLY by DATABASE_URL (docker-compose locally, Neon when deployed).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/internal_tools

# Auth.js
AUTH_SECRET=dev-secret-change-me
AUTH_URL=http://localhost:3000

# Entra ID OIDC (production identity provider). Leave blank in dev/demo.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Demo credentials provider (mock IdP issuing fake Entra group claims). MUST be false in production.
DEMO_AUTH_ENABLED=true

# Entra group -> platform role map (JSON). Falls back to the documented demo map when unset.
# ENTRA_GROUP_MAP={"ENTRA-KYC-Analysts":["kyc_analyst"],"ENTRA-Platform-Admins":["admin"]}

# 'mock' uses in-repo mock providers; 'live' is reserved for real integrations (not built).
PROVIDER_MODE=mock

# Throwaway database used by lib/audit integration tests.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/internal_tools_test

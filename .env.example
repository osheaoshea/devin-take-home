# Environments differ ONLY by DATABASE_URL (docker-compose locally, Neon when deployed).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/internal_tools

# Auth.js
AUTH_SECRET=dev-secret-change-me
AUTH_URL=http://localhost:3000

# Entra ID OIDC (production identity provider). Leave blank in dev/demo.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Demo credentials provider (mock IdP issuing fake Entra group claims). Off by default; set true
# for a local demo. It is refused outright unless the app is served from localhost, so copying
# this file into a deployed environment cannot enable it.
DEMO_AUTH_ENABLED=false

# Escape hatch for a throwaway hosted demo: allows DEMO_AUTH_ENABLED on a non-localhost host.
# Never set this on an environment holding real data.
# DEMO_AUTH_ALLOW_REMOTE_HOST=false

# Entra group -> platform role map (JSON). Falls back to the documented demo map when unset.
# ENTRA_GROUP_MAP={"ENTRA-KYC-Analysts":["kyc_analyst"],"ENTRA-Platform-Admins":["admin"]}

# Shared secret the KYC provider must send as X-Webhook-Secret on POST /api/webhooks/kyc. The
# route is unauthenticated otherwise, so an unset value refuses every callback.
KYC_WEBHOOK_SECRET=dev-webhook-secret-change-me

# Throwaway database used by lib/audit integration tests.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/internal_tools_test
